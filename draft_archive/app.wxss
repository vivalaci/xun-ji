/* app.wxss —— 全局样式 */
page {
  --primary: #2563eb;
  --primary-light: #dbeafe;
  --bg: #f3f4f6;
  --card: #ffffff;
  --text: #111827;
  --text-muted: #6b7280;
  --border: #e5e7eb;
  --danger: #ef4444;
  --success: #10b981;
  background-color: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 按钮 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 2.8;
}
.btn-primary::after { border: none; }

.btn-ghost {
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 2.6;
}
.btn-ghost::after { border: none; }

/* 浮动新建按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 60rpx;
  line-height: 108rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
  z-index: 100;
}

/* 文字辅助 */
.muted { color: var(--text-muted); }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.bold { font-weight: 600; }

/* 空状态 */
.empty {
  text-align: center;
  color: var(--text-muted);
  padding: 120rpx 0;
  font-size: 28rpx;
}

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.form-item:last-child { border-bottom: none; }
.form-label { color: var(--text-muted); }
.form-input {
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}
