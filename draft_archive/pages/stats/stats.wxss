/* pages/stats/stats.wxss */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
}
.stat-item {
  width: 50%;
  text-align: center;
  padding: 20rpx 0;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 6rpx;
}
.month-line {
  text-align: center;
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
}
.accent { color: var(--primary); }

.bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 280rpx;
  margin-top: 28rpx;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.bar-count {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}
.bar-track {
  width: 36rpx;
  height: 180rpx;
  background: var(--bg);
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.bar-fill {
  width: 100%;
  background: var(--primary);
  border-radius: 8rpx;
  min-height: 4rpx;
  transition: height 0.3s ease;
}
.bar-label {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 10rpx;
}

.pr-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.pr-item:last-child { border-bottom: none; }
.pr-empty {
  text-align: center;
  padding: 40rpx 0;
}
