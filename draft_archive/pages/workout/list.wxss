/* pages/workout/list.wxss */
.summary {
  display: flex;
  align-items: center;
}
.summary-item {
  flex: 1;
  text-align: center;
}
.summary-num {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 8rpx;
}
.summary-divider {
  width: 1rpx;
  height: 64rpx;
  background: var(--border);
}

.workout-item {
  position: relative;
}
.workout-name {
  font-size: 32rpx;
}
.workout-meta {
  margin-top: 18rpx;
  flex-wrap: wrap;
  gap: 14rpx;
}
.tag {
  background: var(--bg);
  color: var(--text-muted);
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.workout-note {
  margin-top: 16rpx;
  font-size: 26rpx;
}
.del-btn {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  color: var(--danger);
  font-size: 24rpx;
  padding: 8rpx 12rpx;
}
