/* pages/workout/edit.wxss */
.edit-page { padding-bottom: 60rpx; }

.ex-head { margin-bottom: 16rpx; }
.ex-remove { color: var(--danger); font-size: 24rpx; }

.set-head {
  font-size: 24rpx;
  color: var(--text-muted);
  padding: 8rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.set-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.set-col-idx { width: 80rpx; text-align: center; color: var(--text-muted); }
.set-col { flex: 1; text-align: center; }
.set-input {
  background: var(--bg);
  border-radius: 8rpx;
  margin: 0 10rpx;
  padding: 12rpx 0;
  text-align: center;
}
.set-col-del { width: 60rpx; text-align: center; color: var(--text-muted); }

.add-set {
  margin-top: 18rpx;
  color: var(--primary);
  font-size: 26rpx;
  text-align: center;
  padding: 12rpx 0;
}

.add-ex {
  text-align: center;
  margin-bottom: 24rpx;
}
.save-btn { margin-top: 16rpx; }

/* 选择面板 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
}
.picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  padding-bottom: env(safe-area-inset-bottom);
}
.picker-panel.show { transform: translateY(0); }
.picker-head {
  padding: 28rpx;
  border-bottom: 1rpx solid var(--border);
}
.picker-close { color: var(--primary); }
.picker-body {
  display: flex;
  height: 560rpx;
}
.cat-list {
  width: 180rpx;
  background: var(--bg);
  height: 100%;
}
.cat-item {
  padding: 30rpx 0;
  text-align: center;
  color: var(--text-muted);
  font-size: 28rpx;
}
.cat-item.active {
  background: #fff;
  color: var(--primary);
  font-weight: 600;
}
.ex-list { flex: 1; height: 100%; }
.ex-pick {
  padding: 30rpx 36rpx;
  border-bottom: 1rpx solid var(--border);
}
.ex-pick:active { background: var(--primary-light); }

.custom-row {
  padding: 24rpx 28rpx;
  border-top: 1rpx solid var(--border);
}
.custom-input {
  flex: 1;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}
.custom-add {
  margin-left: 20rpx;
  color: #fff;
  background: var(--primary);
  border-radius: 12rpx;
  padding: 16rpx 32rpx;
}
