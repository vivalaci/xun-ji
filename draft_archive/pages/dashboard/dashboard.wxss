/* pages/dashboard/dashboard.wxss */

/* 顶部问候 */
.hero {
  padding: 16rpx 8rpx 32rpx;
}
.hero-greet {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
}
.hero-date {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.card-title { margin-bottom: 20rpx; }
.card-subtitle { font-size: 24rpx; margin-bottom: 8rpx; }
.link { color: var(--primary); font-size: 26rpx; }

/* 今日训练 */
.today-item {
  padding: 20rpx;
  background: var(--bg);
  border-radius: 14rpx;
  margin-bottom: 16rpx;
}
.today-item:last-child { margin-bottom: 0; }
.today-meta { font-size: 24rpx; margin-top: 8rpx; }
.today-empty {
  text-align: center;
  padding: 20rpx 0 8rpx;
}
.today-empty-tip { margin-bottom: 24rpx; }
.start-btn { width: 60%; margin: 0 auto; }

/* 本周进度 */
.week-bars {
  display: flex;
  justify-content: space-between;
}
.week-day {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg);
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
}
.dot.done {
  background: var(--primary);
  border-color: var(--primary);
}
.dot.today {
  border-color: var(--primary);
  border-width: 4rpx;
}
.dot-check { color: #fff; font-size: 28rpx; }
.week-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 10rpx;
}
.accent { color: var(--primary); font-weight: 600; }

/* 体重 */
.weight-card { align-items: center; }
.weight-row {
  display: flex;
  align-items: baseline;
}
.weight-num {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--primary);
}
.weight-unit { font-size: 26rpx; margin-left: 6rpx; }
.weight-delta {
  font-size: 26rpx;
  margin-left: 16rpx;
  align-self: center;
}
.weight-delta.up { color: var(--danger); }
.weight-delta.down { color: var(--success); }

/* 快捷入口 */
.quick-row {
  display: flex;
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-muted);
}
.quick-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.footer {
  text-align: center;
  font-size: 24rpx;
  padding: 16rpx 0 40rpx;
}
