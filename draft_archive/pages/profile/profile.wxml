<!-- pages/profile/profile.wxml -->
<view class="container">

  <view class="card profile-head">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-placeholder">头像</view>
    </button>
    <input class="nickname" type="nickname" value="{{nickname}}" bindblur="onNickInput" placeholder="点击设置昵称" />
  </view>

  <view class="card menu">
    <view class="menu-item row between" bindtap="about">
      <text>关于训记</text>
      <text class="muted">›</text>
    </view>
    <view class="menu-item row between">
      <text>版本</text>
      <text class="muted">1.0.0</text>
    </view>
  </view>

  <view class="tip muted">数据存储在你的微信云开发环境，仅你本人可见</view>

</view>
