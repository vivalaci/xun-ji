/* pages/body/body.wxss */
.sync-tip { font-size: 24rpx; text-align: center; padding: 8rpx 0 20rpx; }

/* 身体趋势合并图（迁自首页） */
.range-bar { display: flex; background: var(--card); border-radius: 16rpx; padding: 6rpx; margin-bottom: 24rpx; }
.range-item { flex: 1; text-align: center; padding: 14rpx 0; font-size: 26rpx; color: var(--muted); border-radius: 12rpx; }
.range-item.active { background: #fff; color: var(--text); font-weight: 600; }
.chart-card { padding: 28rpx; }
.chart { width: 100%; height: 300rpx; }
.legend { flex-wrap: wrap; gap: 24rpx; margin-bottom: 12rpx; }
.legend-item { gap: 8rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 14rpx; }
.legend-name { font-size: 24rpx; }
.legend-val { font-size: 26rpx; font-weight: 600; color: var(--text); }
.body-item { align-items: center; }
.body-values { gap: 18rpx; }
.body-fat { font-size: 26rpx; }
.pending-tag { color: var(--warning); background: #FEF3C7; }
.list-end { text-align: center; font-size: 22rpx; padding: 16rpx 0 32rpx; }
