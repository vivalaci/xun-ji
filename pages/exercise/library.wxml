<!-- pages/exercise/library.wxml -->
<view class="container">
  <!-- 管理模式提示条（仅管理员可见） -->
  <view wx:if="{{adminMode}}" class="admin-bar row between">
    <text class="admin-tag">管理模式</text>
    <view class="row admin-actions">
      <text class="admin-link" bindtap="openCatPanel">类别编排</text>
      <text class="admin-link" bindtap="exitAdmin">退出</text>
    </view>
  </view>

  <view class="search-row row">
    <input class="search-input" placeholder="搜索动作名称 / 别名" value="{{searchKw}}" bindinput="onSearchInput" confirm-type="search" />
    <text wx:if="{{searchKw}}" class="search-clear" bindtap="clearSearch">✕</text>
  </view>

  <!-- 搜索结果（扁平列表，标注分类） -->
  <view wx:if="{{searching}}" class="card">
    <view wx:if="{{searchResults.length === 0}}" class="search-empty muted">无匹配动作</view>
    <view wx:for="{{searchResults}}" wx:for-item="ex" wx:key="id"
          class="ex-row row between" bindtap="goDetail" data-id="{{ex.id}}">
      <view class="row ex-left">
        <text>{{ex.name}}</text>
        <text wx:if="{{ex.isMainLift}}" class="main-badge">主项</text>
        <text wx:if="{{ex.custom}}" class="custom-badge">自建</text>
        <text wx:if="{{adminMode && ex.global}}" class="custom-badge">全局</text>
        <text class="ex-cat muted">{{ex.category}}</text>
      </view>
      <view class="row ex-actions">
        <text wx:if="{{adminMode && !ex.custom}}" class="edit-btn" catchtap="openEdit" data-id="{{ex.id}}">编辑</text>
            <text wx:if="{{adminMode && ex.custom}}" class="edit-btn" catchtap="openEdit" data-id="{{ex.id}}">升格</text>
        <text wx:if="{{ex.custom}}" class="del-btn" catchtap="onDelete" data-docid="{{ex._id}}">删除</text>
      </view>
    </view>
  </view>

  <!-- 分类分组 -->
  <block wx:else>
    <view wx:for="{{groups}}" wx:key="category" class="cat-group">
      <view class="cat-title muted">{{item.category}}</view>
      <view class="card">
        <view wx:for="{{item.items}}" wx:for-item="ex" wx:key="id"
              class="ex-row row between" bindtap="goDetail" data-id="{{ex.id}}">
          <view class="row ex-left">
            <text class="{{ex.hidden ? 'muted' : ''}}">{{ex.name}}</text>
            <text wx:if="{{ex.isMainLift}}" class="main-badge">主项</text>
            <text wx:if="{{ex.custom}}" class="custom-badge">自建</text>
            <text wx:if="{{adminMode && ex.global}}" class="custom-badge">全局</text>
            <text wx:if="{{ex.hidden}}" class="hidden-badge">已隐藏</text>
          </view>
          <view class="row ex-actions">
            <text wx:if="{{adminMode && !ex.custom}}" class="edit-btn" catchtap="openEdit" data-id="{{ex.id}}">编辑</text>
            <text wx:if="{{adminMode && ex.custom}}" class="edit-btn" catchtap="openEdit" data-id="{{ex.id}}">升格</text>
            <text wx:if="{{ex.custom}}" class="del-btn" catchtap="onDelete" data-docid="{{ex._id}}">删除</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 动作计数（连点 5 次为管理入口手势，对普通用户仅是计数文字） -->
    <view class="lib-footer muted" bindtap="onSecretTap">共 {{total}} 个动作</view>
  </block>
</view>

<view class="fab" bindtap="openAdd">+</view>

<!-- 新建动作（普通=自建；管理模式=全局，多一个别名字段） -->
<view wx:if="{{addVisible}}" class="mask" bindtap="closeAdd"></view>
<view class="add-panel {{addVisible ? 'show' : ''}}">
  <view class="picker-head row between">
    <text class="bold">{{adminMode ? '新增全局动作' : '新建自定义动作'}}</text>
    <text class="picker-close" bindtap="closeAdd">取消</text>
  </view>
  <view class="add-body">
    <view class="field row between">
      <text class="label">名称</text>
      <input class="input" placeholder="如：哑铃耸肩" value="{{newName}}" bindinput="onNameInput" />
    </view>
    <view wx:if="{{adminMode}}" class="field row between">
      <text class="label">别名</text>
      <input class="input" placeholder="逗号分隔，可留空" value="{{newAliases}}" bindinput="onNewAliasesInput" />
    </view>
    <view class="field row between no-border">
      <text class="label">分类</text>
      <picker range="{{categories}}" value="{{catIndex}}" bindchange="onCatChange">
        <view class="picker-val">{{categories[catIndex]}} ›</view>
      </picker>
    </view>
    <button class="btn-primary" bindtap="onAdd">添加</button>
  </view>
</view>

<!-- 编辑动作（管理模式：改名 / 改分类 / 改别名 / 隐藏） -->
<view wx:if="{{editVisible}}" class="mask" bindtap="closeEdit"></view>
<view class="add-panel {{editVisible ? 'show' : ''}}">
  <view class="picker-head row between">
    <text class="bold">{{editTarget.custom ? '升格为全局动作' : '编辑动作'}}</text>
    <text class="picker-close" bindtap="closeEdit">取消</text>
  </view>
  <view class="add-body" wx:if="{{editTarget}}">
    <view class="field row between">
      <text class="label">名称</text>
      <input class="input" value="{{editName}}" bindinput="onEditNameInput" />
    </view>
    <view class="field row between">
      <text class="label">别名</text>
      <input class="input" placeholder="逗号分隔，可留空" value="{{editAliases}}" bindinput="onEditAliasesInput" />
    </view>
    <view class="field row between {{editTarget.custom ? 'no-border' : ''}}">
      <text class="label">分类</text>
      <block wx:if="{{!editTarget.cardio}}">
        <picker range="{{editCats}}" value="{{editCatIndex}}" bindchange="onEditCatChange">
          <view class="picker-val">{{editCats[editCatIndex]}} ›</view>
        </picker>
      </block>
      <text wx:else class="muted">有氧（固定）</text>
    </view>
    <!-- 升格说明（自建）：建全局动作 + 本人引用改指新 id + 删除原自建 -->
    <view wx:if="{{editTarget.custom}}" class="promote-note muted">保存后将成为全局动作，对所有用户可见；你的历史记录、模板与曲线会自动改指新动作（进步曲线连续），原自建动作删除。</view>
    <!-- 隐藏开关（内置/全局） -->
    <view wx:if="{{!editTarget.custom}}" class="field row between no-border">
      <view>
        <text class="label">隐藏该动作</text>
        <view wx:if="{{editTarget.isMainLift}}" class="field-note muted">三大项与首页曲线绑定，不可隐藏</view>
        <view wx:elif="{{editHidden}}" class="field-note muted">从列表与搜索中消失；历史记录仍正常显示</view>
      </view>
      <switch checked="{{editHidden}}" disabled="{{editTarget.isMainLift}}" bindchange="onEditHiddenChange" />
    </view>
    <button class="btn-primary" bindtap="onEditSave">{{editTarget.custom ? '升格并发布' : '保存'}}</button>
    <!-- 全局动作可删除（升格错误的回退路径；本人引用自动改指同名动作） -->
    <view wx:if="{{editTarget.global}}" class="del-global" bindtap="onDeleteGlobal">删除全局动作</view>
  </view>
</view>

<!-- 类别编排（管理模式：新增类别 + 上下移；有氧固定末位） -->
<view wx:if="{{catPanelVisible}}" class="mask" bindtap="closeCatPanel"></view>
<view class="add-panel {{catPanelVisible ? 'show' : ''}}">
  <view class="picker-head row between">
    <text class="bold">类别编排</text>
    <text class="picker-close" bindtap="closeCatPanel">取消</text>
  </view>
  <view class="add-body">
    <scroll-view scroll-y class="cat-scroll">
      <view wx:for="{{catList}}" wx:key="*this" class="cat-item row between">
        <text>{{item}}</text>
        <view class="row cat-ops">
          <text class="cat-op {{index === 0 ? 'disabled' : ''}}" catchtap="moveCat" data-index="{{index}}" data-dir="-1">↑</text>
          <text class="cat-op {{index === catList.length - 1 ? 'disabled' : ''}}" catchtap="moveCat" data-index="{{index}}" data-dir="1">↓</text>
        </view>
      </view>
      <view class="cat-item row between">
        <text class="muted">有氧</text>
        <text class="muted cat-fixed">固定末位</text>
      </view>
    </scroll-view>
    <view class="field row between no-border">
      <input class="input cat-new-input" placeholder="新增类别名称" value="{{newCatName}}" bindinput="onNewCatInput" />
      <text class="admin-link" bindtap="addCat">添加</text>
    </view>
    <button class="btn-primary" bindtap="onCatSave">保存顺序</button>
  </view>
</view>
