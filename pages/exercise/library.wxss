/* pages/exercise/library.wxss */
.cat-group { margin-bottom: 24rpx; }
.cat-title { font-size: 24rpx; margin: 8rpx 0 12rpx 8rpx; }
.ex-row { padding: 24rpx 0; border-bottom: 1rpx solid var(--border); }
.ex-row:last-child { border-bottom: none; }
.ex-left { gap: 14rpx; }
.main-badge {
  font-size: 20rpx; color: var(--accent); background: var(--accent-light);
  border-radius: 6rpx; padding: 2rpx 10rpx;
}
.custom-badge {
  font-size: 20rpx; color: var(--muted); background: var(--bg);
  border-radius: 6rpx; padding: 2rpx 10rpx;
}
.del-btn { color: var(--danger); font-size: 24rpx; }

/* 新建面板 */
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 200; }
.add-panel {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; border-radius: 28rpx 28rpx 0 0; z-index: 201;
  transform: translateY(100%); transition: transform 0.25s ease;
  padding-bottom: env(safe-area-inset-bottom);
}
.add-panel.show { transform: translateY(0); }
.picker-head { padding: 28rpx; border-bottom: 1rpx solid var(--border); }
.picker-close { color: var(--accent); }
.add-body { padding: 16rpx 32rpx 32rpx; }
.field { padding: 28rpx 0; border-bottom: 1rpx solid var(--border); }
.field.no-border { border-bottom: none; margin-bottom: 24rpx; }
.label { color: var(--muted); }
.input { text-align: right; flex: 1; margin-left: 24rpx; }
.picker-val { color: var(--text); }
