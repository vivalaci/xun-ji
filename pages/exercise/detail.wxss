/* pages/exercise/detail.wxss */
.range-bar { display: flex; background: var(--card); border-radius: 16rpx; padding: 6rpx; margin-bottom: 24rpx; }
.range-item { flex: 1; text-align: center; padding: 14rpx 0; font-size: 26rpx; color: var(--muted); border-radius: 12rpx; }
.range-item.active { background: #fff; color: var(--text); font-weight: 600; }

.chart-card { padding: 28rpx; }
.chart-cap { font-size: 24rpx; margin-bottom: 8rpx; }
.chart { width: 100%; height: 360rpx; }
.chart-empty { width: 100%; height: 360rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; }

.sec-title { font-size: 24rpx; margin: 24rpx 0 12rpx 8rpx; }
.hist-item { padding: 24rpx 32rpx; }
.hist-date { gap: 14rpx; }
.hist-variant {
  font-size: 20rpx; color: var(--accent); background: var(--accent-light);
  border-radius: 6rpx; padding: 2rpx 12rpx;
}
.pr-badge {
  font-size: 20rpx; color: #fff; background: var(--warning);
  border-radius: 6rpx; padding: 2rpx 12rpx; font-weight: 600;
}
.hist-sets { margin-top: 12rpx; color: var(--text); font-size: 28rpx; }
