/* pages/curve/curve.wxss */
.range-bar {
  display: flex;
  background: var(--card);
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.range-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--muted);
  border-radius: 12rpx;
}
.range-item.active {
  background: #fff;
  color: var(--text);
  font-weight: 600;
}

.chart-card { padding: 28rpx; }
.chart-head { margin-bottom: 8rpx; }
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}
.latest { font-size: 30rpx; font-weight: 700; color: var(--text); }
.no-data { font-size: 24rpx; }
.chart { width: 100%; height: 300rpx; }

/* 添加曲线入口 */
.add-curve {
  text-align: center;
  color: var(--accent);
  background: var(--accent-light);
  border-radius: 16rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.add-curve.disabled {
  color: var(--disabled);
  background: var(--card);
}
.edit-hint {
  text-align: center;
  font-size: 22rpx;
  padding-bottom: 24rpx;
}

/* 编辑模式 */
.edit-title { padding: 8rpx 8rpx 24rpx; }
.edit-done { color: var(--accent); font-size: 28rpx; }
.edit-row { padding: 26rpx 28rpx; }
.edit-ops { gap: 16rpx; }
.op-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: var(--bg);
  border-radius: 12rpx;
  font-size: 32rpx;
  color: var(--text);
}
.op-disabled { color: var(--disabled); }
.op-del { color: var(--danger); }
.op-placeholder { background: transparent; }

/* 动作选择面板（同训练编辑页样式风格） */
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 200; }
.picker-panel {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  padding-bottom: env(safe-area-inset-bottom);
}
.picker-panel.show { transform: translateY(0); }
.picker-head { padding: 28rpx; border-bottom: 1rpx solid var(--border); }
.picker-close { color: var(--muted); }
.picker-body { display: flex; height: 560rpx; }
.cat-list { width: 170rpx; background: var(--card); height: 100%; }
.cat-item { padding: 30rpx 0; text-align: center; color: var(--muted); font-size: 28rpx; }
.cat-item.active { background: #fff; color: var(--text); font-weight: 600; }
.ex-list { flex: 1; height: 100%; }
.ex-pick { padding: 30rpx 36rpx; border-bottom: 1rpx solid var(--border); }
.ex-pick:active { background: var(--accent-light); }
.ex-disabled { color: var(--disabled); }
.shown-badge {
  font-size: 20rpx;
  color: var(--muted);
  background: var(--bg);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
}
