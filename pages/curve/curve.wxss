/* pages/curve/curve.wxss */
.range-bar {
  display: flex;
  background: var(--card);
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.range-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--muted);
  border-radius: 12rpx;
}
.range-item.active {
  background: #fff;
  color: var(--text);
  font-weight: 600;
}

.chart-card { padding: 28rpx; }
.chart-head { margin-bottom: 8rpx; }
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}
.latest { font-size: 30rpx; font-weight: 700; color: var(--text); }
.no-data { font-size: 24rpx; }
.chart { width: 100%; height: 300rpx; }
