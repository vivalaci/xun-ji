<!-- pages/template/manage.wxml —— 按组分节 -->
<view class="container">
  <view wx:if="{{loaded && empty}}" class="empty">还没有模板
点下方按钮新建</view>

  <block wx:for="{{groups}}" wx:key="name" wx:for-item="grp">
    <view class="group-title muted">{{grp.name}}</view>
    <view wx:for="{{grp.items}}" wx:key="_id" class="card tpl-item row between"
          bindtap="goEdit" data-id="{{item._id}}">
      <view>
        <view class="bold">{{item.name}}</view>
        <view class="muted tpl-meta">{{item.count}} 个动作</view>
      </view>
      <view class="row tpl-right">
        <text wx:if="{{item.pending}}" class="tag pending-tag">待同步</text>
        <text wx:if="{{item.deletable}}" class="del-btn" catchtap="onDelete" data-id="{{item._id}}">删除</text>
        <text class="muted">›</text>
      </view>
    </view>
  </block>

  <button class="btn-ghost new-btn" bindtap="onNew">+ 新建模板</button>
</view>
