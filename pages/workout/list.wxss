/* pages/workout/list.wxss */

/* 训练日历 */
.cal-card { padding: 24rpx; }
.cal-head { margin-bottom: 18rpx; }
.cal-nav {
  width: 56rpx; height: 56rpx; line-height: 52rpx;
  text-align: center; font-size: 40rpx; color: var(--muted);
}
.cal-title { text-align: center; }
.cal-count { display: block; font-size: 22rpx; margin-top: 4rpx; }

.cal-week { display: flex; margin-bottom: 6rpx; }
.cal-wk { flex: 1; text-align: center; font-size: 22rpx; color: var(--muted); }

.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.28%;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 12rpx;
}
.cal-sel { background: var(--accent-light); }
.cal-day { font-size: 26rpx; color: var(--text); }
.cal-out .cal-day { color: var(--disabled); }
.cal-today {
  color: #fff; background: var(--accent);
  width: 44rpx; height: 44rpx; line-height: 44rpx;
  text-align: center; border-radius: 50%;
}
.cal-dots {
  display: flex; align-items: center;
  height: 18rpx; margin-top: 6rpx; gap: 6rpx;
}
.cal-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.cal-more { font-size: 18rpx; color: var(--muted); }

.cal-detail {
  margin-top: 18rpx;
  border-top: 1rpx solid var(--border);
  padding-top: 16rpx;
}
.cal-detail-date { font-size: 24rpx; margin-bottom: 12rpx; }
.cal-detail-item {
  padding: 16rpx 0;
}
.cal-detail-item .cal-dot { margin-right: 16rpx; }

.sync-tip {
  font-size: 24rpx;
  text-align: center;
  padding: 8rpx 0 20rpx;
}
.workout-item { position: relative; }
.workout-title { gap: 14rpx; }
.workout-name { font-size: 32rpx; }
.pr-badge {
  font-size: 20rpx; color: #fff; background: var(--warning);
  border-radius: 6rpx; padding: 2rpx 12rpx; font-weight: 600;
}
.workout-meta { margin-top: 18rpx; flex-wrap: wrap; gap: 14rpx; }
.pending-tag { color: var(--warning); background: #FEF3C7; }
.del-btn {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  color: var(--danger);
  font-size: 24rpx;
  padding: 8rpx 12rpx;
}
