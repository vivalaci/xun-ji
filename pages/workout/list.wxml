<!-- pages/workout/list.wxml -->
<view class="container">

  <!-- 训练日历 -->
  <view class="card cal-card">
    <view class="cal-head row between">
      <view class="cal-nav" bindtap="prevMonth">‹</view>
      <view class="cal-title">
        <text class="bold">{{calLabel}}</text>
        <text class="muted cal-count">本月训练 {{trainedDays}} 天</text>
      </view>
      <view class="cal-nav" bindtap="nextMonth">›</view>
    </view>

    <view class="cal-week">
      <text wx:for="{{weekHeaders}}" wx:key="*this" class="cal-wk">{{item}}</text>
    </view>

    <view class="cal-grid">
      <view wx:for="{{cells}}" wx:key="dateStr"
            class="cal-cell {{item.inMonth ? '' : 'cal-out'}} {{item.dateStr === selectedDate ? 'cal-sel' : ''}}"
            bindtap="onPickDay" data-date="{{item.dateStr}}">
        <text class="cal-day {{item.isToday ? 'cal-today' : ''}}">{{item.day}}</text>
        <view class="cal-dots">
          <view wx:for="{{item.dots}}" wx:for-item="c" wx:key="index"
                class="cal-dot" style="background: {{c}}"></view>
          <text wx:if="{{item.more > 0}}" class="cal-more">+{{item.more}}</text>
        </view>
      </view>
    </view>

    <!-- 选中日详情 -->
    <view wx:if="{{selectedItems.length}}" class="cal-detail">
      <view class="muted cal-detail-date">{{selectedLabel}}</view>
      <view wx:for="{{selectedItems}}" wx:key="_id" class="cal-detail-item row between"
            bindtap="goEdit" data-id="{{item._id}}">
        <view class="row">
          <view class="cal-dot" style="background: {{item.type.color}}"></view>
          <text>{{item.name}}</text>
        </view>
        <text class="muted">›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{pending}}" class="sync-tip muted">部分记录待联网同步</view>

  <view wx:if="{{loaded && workouts.length === 0}}" class="empty">还没有训练记录
点右下角 + 记录第一次训练</view>

  <view wx:for="{{workouts}}" wx:key="_id" class="card workout-item"
        bindtap="goEdit" data-id="{{item._id}}">
    <view class="row between">
      <view class="row workout-title">
        <text class="bold workout-name">{{item.name}}</text>
        <text wx:if="{{item.prCount > 0}}" class="pr-badge">PR {{item.prCount}}</text>
      </view>
      <view class="muted">{{item.dateLabel}}</view>
    </view>
    <view class="row workout-meta">
      <text class="tag">{{item.exerciseCount}} 个动作</text>
      <text class="tag">{{item.sets}} 组</text>
      <text class="tag">容量 {{item.volume}} {{unitLabel}}</text>
      <text wx:if="{{item.pending}}" class="tag pending-tag">待同步</text>
    </view>
    <view class="del-btn" catchtap="onDelete" data-id="{{item._id}}">删除</view>
  </view>

</view>

<view class="fab" bindtap="goNew">+</view>
