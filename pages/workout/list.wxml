<!-- pages/workout/list.wxml -->
<view class="container">

  <view wx:if="{{pending}}" class="sync-tip muted">部分记录待联网同步</view>

  <view wx:if="{{loaded && workouts.length === 0}}" class="empty">还没有训练记录
点右下角 + 记录第一次训练</view>

  <view wx:for="{{workouts}}" wx:key="_id" class="card workout-item {{item.isToday ? 'today' : ''}}"
        bindtap="goEdit" data-id="{{item._id}}">
    <view class="row between">
      <view class="row workout-title">
        <text class="bold workout-name">{{item.name}}</text>
        <text wx:if="{{item.prCount > 0}}" class="pr-badge">PR {{item.prCount}}</text>
      </view>
      <view class="muted">{{item.dateLabel}}</view>
    </view>
    <view wx:if="{{item.cardio}}" class="muted cardio-summary">{{item.cardioText}}
      <text wx:if="{{item.pending}}" class="tag pending-tag">待同步</text>
    </view>
    <view wx:else class="row workout-meta">
      <text class="tag">{{item.exerciseCount}} 个动作</text>
      <text class="tag">{{item.sets}} 组</text>
      <text class="tag">容量 {{item.volume}} {{unitLabel}}</text>
      <text wx:if="{{item.pending}}" class="tag pending-tag">待同步</text>
    </view>
    <view class="del-btn" catchtap="onDelete" data-id="{{item._id}}">删除</view>
  </view>

  <view wx:if="{{loaded && workouts.length > 0 && !hasMore}}" class="list-end muted">没有更多了</view>

</view>

<view class="fab" bindtap="goNew">+</view>
