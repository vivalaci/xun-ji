/* pages/workout/edit.wxss */

/* 选模板 */
.pick-title { margin-bottom: 8rpx; }
.pick-sub { margin-bottom: 32rpx; font-size: 26rpx; }
.group-title {
  font-size: 24rpx;
  margin: 8rpx 8rpx 16rpx;
}
.tpl-card + .group-title { margin-top: 32rpx; }
.tpl-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 16rpx;
}
.tpl-card.blank {
  border: 2rpx dashed var(--disabled);
  background: transparent;
}
.tpl-meta { font-size: 24rpx; margin-top: 8rpx; }

/* 录入 */
.edit-page { padding-bottom: 60rpx; }
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.form-item.no-border { border-bottom: none; }
.form-val { text-align: right; flex: 1; margin-left: 24rpx; }
.input-val { color: var(--text); }

.ex-head { margin-bottom: 18rpx; }
.ex-name { font-size: 32rpx; }
.ex-remove { color: var(--danger); font-size: 24rpx; }

.set-head {
  font-size: 22rpx;
  color: var(--muted);
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--border);
}
.col-idx { width: 56rpx; text-align: center; color: var(--muted); }
.col-main { flex: 1; text-align: center; }
.col-del { width: 56rpx; text-align: center; color: var(--muted); }

.set-row { padding: 14rpx 0; border-bottom: 1rpx solid var(--border); }
.stepper {
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  background: var(--bg);
  border-radius: 10rpx;
  color: var(--text);
  font-size: 36rpx;
}
.step-input {
  width: 90rpx;
  text-align: center;
  margin: 0 8rpx;
  background: var(--bg);
  border-radius: 10rpx;
  padding: 10rpx 0;
}

.add-set {
  margin-top: 18rpx;
  color: var(--accent);
  font-size: 26rpx;
  text-align: center;
  padding: 10rpx 0;
}
.add-ex { text-align: center; margin-bottom: 20rpx; }
.save-btn { margin-top: 12rpx; }

/* 动作选择面板 */
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 200; }
.picker-panel {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  padding-bottom: env(safe-area-inset-bottom);
}
.picker-panel.show { transform: translateY(0); }
.picker-head { padding: 28rpx; border-bottom: 1rpx solid var(--border); }
.picker-close { color: var(--accent); }
.picker-body { display: flex; height: 560rpx; }
.cat-list { width: 170rpx; background: var(--card); height: 100%; }
.cat-item { padding: 30rpx 0; text-align: center; color: var(--muted); font-size: 28rpx; }
.cat-item.active { background: #fff; color: var(--text); font-weight: 600; }
.ex-list { flex: 1; height: 100%; }
.ex-pick { padding: 30rpx 36rpx; border-bottom: 1rpx solid var(--border); }
.ex-pick:active { background: var(--accent-light); }
.main-badge {
  font-size: 20rpx;
  color: var(--accent);
  background: var(--accent-light);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
}
.custom-row { padding: 24rpx 28rpx; border-top: 1rpx solid var(--border); }
.custom-input { flex: 1; background: var(--card); border-radius: 12rpx; padding: 16rpx 24rpx; }
.custom-add { margin-left: 20rpx; color: #fff; background: var(--accent); border-radius: 12rpx; padding: 16rpx 32rpx; }
