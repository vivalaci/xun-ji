/* pages/workout/pick.wxss —— 选模板（样式与原 edit 选模板阶段一致） */
.pick-title { margin-bottom: 24rpx; }
.group-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin: 0 8rpx 8rpx;
}
.group-note {
  font-size: 22rpx;
  line-height: 1.6;
  margin: 0 8rpx 16rpx;
}
.tpl-card + .group-title { margin-top: 36rpx; }
.tpl-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 16rpx;
}
.tpl-card.blank {
  border: 2rpx dashed var(--disabled);
  background: transparent;
}
.tpl-meta { font-size: 24rpx; margin-top: 8rpx; }
.tpl-right { gap: 4rpx; }
.tpl-del { color: var(--danger); font-size: 24rpx; padding: 8rpx 12rpx; }
.tpl-dot { width: 20rpx; height: 20rpx; border-radius: 50%; flex: none; margin-left: 24rpx; }
