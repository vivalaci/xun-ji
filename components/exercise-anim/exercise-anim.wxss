/* components/exercise-anim —— 三层叠放 + 乒乓循环 */
.anim { position: relative; margin: 0 auto; }
.anim.md { width: 440rpx; height: 440rpx; }
.anim.lg { width: 600rpx; height: 600rpx; }

.frame {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
}
.frame.f0 { opacity: 1; } /* 未开始播放时静显第 0 帧 */

/* 一轮 1.8s = 4 个 450ms 时段：帧0 | 帧1 | 帧2 | 帧1；step-end 硬切不渐变 */
.playing .frame {
  animation-duration: 1.8s;
  animation-iteration-count: infinite;
  animation-timing-function: step-end;
}
.playing .f0 { animation-name: ex-frame-0; }
.playing .f1 { animation-name: ex-frame-1; }
.playing .f2 { animation-name: ex-frame-2; }

@keyframes ex-frame-0 {
  0% { opacity: 1; }
  25% { opacity: 0; }
  100% { opacity: 0; }
}
@keyframes ex-frame-1 {
  0% { opacity: 0; }
  25% { opacity: 1; }
  50% { opacity: 0; }
  75% { opacity: 1; }
  100% { opacity: 1; }
}
@keyframes ex-frame-2 {
  0% { opacity: 0; }
  50% { opacity: 1; }
  75% { opacity: 0; }
  100% { opacity: 0; }
}
